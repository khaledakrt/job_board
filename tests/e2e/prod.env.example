# Copy this file to tests/e2e/prod.env before running production E2E checks.
# Never commit tests/e2e/prod.env.

E2E_BASE_URL=https://tun-job-board.com
E2E_API_URL=https://tun-job-board.com/api

# Enable login checks only after filling real dedicated production test accounts.
E2E_WITH_ROLE_LOGINS=false

TEST_PASSWORD=
TEST_CANDIDATE_EMAIL=
TEST_CANDIDATE_PASSWORD=
TEST_CANDIDATE_SIGNUP_INBOX=
TEST_RECRUITER_EMAIL=
TEST_RECRUITER_PASSWORD=
TEST_ADMIN_EMAIL=
TEST_ADMIN_PASSWORD=

# Optional future accounts for full-role recette.
TEST_RECRUITER_MEMBER_EMAIL=
TEST_RECRUITER_MEMBER_PASSWORD=
TEST_FORMATION_PROVIDER_EMAIL=
TEST_FORMATION_PROVIDER_PASSWORD=
TEST_INSTITUTION_PROVIDER_EMAIL=
TEST_INSTITUTION_PROVIDER_PASSWORD=

# Destructive / data-changing tests must stay disabled unless explicitly planned.
E2E_ALLOW_PROD_MUTATIONS=false
E2E_ALLOW_CANDIDATE_MUTATIONS=false

# Optional for candidate account creation / email verification recette tests.
TEST_ACCOUNT_CREATION_PASSWORD=Test1234!
TEST_CANDIDATE_VERIFY_TOKEN=
