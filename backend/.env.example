# Application
NODE_ENV=development
PORT=3000
API_PREFIX=/api

# Frontend (CORS)
CLIENT_URL=http://localhost:4200

# MySQL
DB_HOST=localhost
DB_PORT=3306
DB_NAME=job_board
DB_USER=root
DB_PASSWORD=your_password_here
DB_POOL_MAX=10
DB_POOL_MIN=0
DB_POOL_ACQUIRE=30000
DB_POOL_IDLE=10000

# JWT
JWT_ACCESS_SECRET=change_me_to_a_long_random_access_secret_min_32_chars
JWT_REFRESH_SECRET=change_me_to_a_long_random_refresh_secret_min_32_chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Password reset
PASSWORD_RESET_EXPIRES_HOURS=1

# Cookie
COOKIE_SECURE=false
COOKIE_SAME_SITE=strict

# Rate limiting (auth endpoints)
# Auth rate limit (login/register). In development the server uses at least 30 attempts per minute.
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=5
GLOBAL_RATE_LIMIT_WINDOW_MS=900000
GLOBAL_RATE_LIMIT_MAX=100

# Public API URL (logo links, email assets)
API_PUBLIC_URL=http://localhost:3000
UPLOAD_DIR=uploads

# Subscription mock bypass (development only)
SUBSCRIPTION_MOCK_BYPASS=true

# Analyse CV : off (gratuit, heuristique) | ollama (gratuit, local) | openai (payant)
CV_LLM_PROVIDER=off
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Tous les e-mails (inscription, MDP oublié, alertes candidat, équipe recruteur, etc.)
# passent par ce compte Gmail (mot de passe d'application, pas le mot de passe de connexion).
EMAIL_USER=your@gmail.com
EMAIL_PASS=your_16_char_app_password_without_spaces
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_FROM_NAME=Job Board
SMTP_FROM_EMAIL=your@gmail.com

# E-mails (dev) : à la racine du projet → docker compose up -d mailpit
# Boîte web : http://localhost:8025 — SMTP sans mot de passe sur le port 1025
# SMTP_HOST=localhost
# SMTP_PORT=1025
# SMTP_SECURE=false
# SMTP_FROM_NAME=Job Board
# SMTP_FROM_EMAIL=noreply@jobboard.local

# Production / Gmail (mot de passe d'application : https://myaccount.google.com/apppasswords)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your@gmail.com
SMTP_PASS=your_16_char_app_password_without_spaces
SMTP_FROM_NAME=Job Board
SMTP_FROM_EMAIL=your@gmail.com

# Formulaire de contact (page publique)
CONTACT_TO_EMAIL=khaliid.akrout@gmail.com
