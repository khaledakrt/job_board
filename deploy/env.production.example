# Copier vers backend/.env sur le serveur : cp deploy/env.production.example backend/.env
# Puis remplacer toutes les valeurs CHANGE_ME et les secrets.
# En production, l'API refusera de démarrer si un placeholder CHANGE_ME reste présent.

NODE_ENV=production
PORT=3000
API_PREFIX=/api
TRUST_PROXY=1
ENABLE_SCHEDULER=false

# URL publique du site (HTTPS recommandé)
CLIENT_URL=https://votre-domaine.fr
API_PUBLIC_URL=https://votre-domaine.fr

# MySQL (local ou service managé)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=job_board
DB_USER=jobboard
DB_PASSWORD=CHANGE_ME_STRONG_DB_PASSWORD

# JWT — générer deux chaînes aléatoires ≥ 32 caractères (openssl rand -hex 32)
JWT_ACCESS_SECRET=CHANGE_ME_ACCESS_SECRET_MIN_32_CHARS
JWT_REFRESH_SECRET=CHANGE_ME_REFRESH_SECRET_MIN_32_CHARS
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

PASSWORD_RESET_EXPIRES_HOURS=1
EMAIL_VERIFICATION_EXPIRES_HOURS=48

# HTTPS obligatoire en production pour les cookies de session
COOKIE_SECURE=true
COOKIE_SAME_SITE=lax

AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=20
GLOBAL_RATE_LIMIT_WINDOW_MS=900000
GLOBAL_RATE_LIMIT_MAX=500
RATE_LIMIT_STORE=memory
# REDIS_URL=redis://127.0.0.1:6379

UPLOAD_DIR=uploads
SUBSCRIPTION_MOCK_BYPASS=false

# E-mail (SMTP domaine JobBoard)
SMTP_HOST=mail.tun-job-board.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=support@tun-job-board.com
SMTP_PASS=CHANGE_ME
SMTP_FROM_NAME=Support Tun Job
SMTP_FROM_EMAIL=support@tun-job-board.com
CONTACT_TO_EMAIL=contact@tun-job-board.com

# Paiement en ligne recruteur (Konnect Tunisie)
KONNECT_API_BASE_URL=https://api.konnect.network/api/v2
# KONNECT_API_KEY=
# KONNECT_WALLET_ID=
KONNECT_ACCEPTED_METHODS=wallet,bank_card,e-DINAR,flouci
KONNECT_PAYMENT_LIFESPAN_MINUTES=30

# CV : off = sans IA (léger) | ollama = nécessite Ollama sur le serveur (RAM)
CV_LLM_PROVIDER=off
